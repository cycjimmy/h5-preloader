{
  "name": "@cycjimmy/h5-preloader",
  "type": "module",
  "version": "5.0.4",
  "description": "Resources pre-load for h5 page",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/h5-preloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/h5-preloader.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/h5-preloader/issues"
  },
  "keywords": [
    "h5",
    "preloader"
  ],
  "exports": {
    "import": "./dist/h5-preloader.esm.js",
    "default": "./dist/h5-preloader.esm.js"
  },
  "main": "dist/h5-preloader.esm.js",
  "module": "dist/h5-preloader.esm.js",
  "browser": "dist/h5-preloader.umd.min.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm run dev",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:style:fix": "stylelint \"**/*.css\" --fix",
    "dev": "vite",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^5.0.0",
    "resource-loader": "^4.0.0-rc4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@cycjimmy/config-lib": "^3.2.2",
    "babel-jest": "^30.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.8"
  }
}
